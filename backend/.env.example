# ---- LLM provider -------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Local fallback (Ollama). Start with: ollama serve && ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Which provider boots by default: gemini | ollama | echo
DEFAULT_PROVIDER=gemini

# ---- Storage ------------------------------------------------------------
# SQLite for the local MVP. Swap to postgresql+psycopg://... for Phase 3.
DATABASE_URL=sqlite:///./storystudio.db
